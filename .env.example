# Bring your own key. Nothing in this repo ships a credential and .env is gitignored.
#
# Default provider is Ollama, which needs NO key at all -- it is an HTTP endpoint on
# your own machine. Leave everything below unset to use it.
#
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
#
# Setting either of these selects that provider automatically:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
#
# Or force one: CAPABILITY_PROVIDER=ollama|openai|anthropic
